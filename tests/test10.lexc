~ DISPLAY
1. print variable value (ex. printf d)
2. print string literal (ex. printf "Hello, world")
3. print string + variable value (ex. printf "Hello, world", d)
~

display();
display("Hello World!");
display("Hello" + msg);

~ CONDITIONALS
1. if
2. else
3. if-else-if
~
if (x > 5) {
    display("x is greater than 5");
}
elif (x == 5) {
    display("x is equal to 5");
}
else {
    display("x is less than 5");
    
    if(1 > 0){
        number kim = get(decimal);
    }
    else{
        display("This is else!");
    }
}

if (x + 5){
    display("This is if without else");
}

~ ITERATION
Required rules (accdg to criteria):
1. 1 simple iteration
2. 1 nested iteration
~
repeat(2) then {
    display("Hello madlang peeople!");
} end

repeat(3) {
    x = x + 1;
    display(x);

    repeat(x < 1){
        display("Yes" + "FM!");
    }
}

